{
	"tab_size": 4,
	"hard_tabs": true,
	"format_on_save": "on",
	"language_servers": ["!prettier"],
	"lsp": {
		"eslint": {
			"settings": {
				"experimental": { "useFlatConfig": true },
				"workingDirectory": { "mode": "auto" },
			},
		},
		"vue-language-server": {
			"initialization_options": {
				"typescript": {
					"tsdk": "node_modules/typescript/lib",
				},
			},
		},
	},
	"languages": {
		"JavaScript": {
			"tab_size": 4,
			"hard_tabs": true,
			"language_servers": ["vtsls", "eslint"],
			"formatter": {
				"code_actions": { "source.fixAll.eslint": true },
			},
		},
		"TypeScript": {
			"tab_size": 4,
			"hard_tabs": true,
			"language_servers": ["vtsls", "eslint"],
			"formatter": {
				"code_actions": { "source.fixAll.eslint": true },
			},
		},
		"Vue.js": {
			"tab_size": 4,
			"language_servers": ["vue-language-server", "vtsls", "eslint"],
			"formatter": {
				"code_actions": { "source.fixAll.eslint": true },
			},
		},
		"CSS": {
			"language_servers": ["tailwindcss-language-server"],
		},
	},
}
