# Caddyfile.template

# --- Environment configuration for Nuxt frontend ---
# These variables define the URLs for API and WebSocket connections.
# Replace HOSTNAME with the host used in the Caddyfile (e.g., localhost or dev.local)
# Replace PORT if your backend runs on a port other than 8080.
#
# Example .env for local development:
# NUXT_PUBLIC_API_BASE=http://HOSTNAME:8080/api
# NUXT_PUBLIC_WS_URL=wss://HOSTNAME/ws/locations
#
# Note: wss:// requires TLS; using 'tls internal' may trigger browser warnings.
# These settings are meant for development, not production.

HOSTNAME:443 {

	tls internal

	# API REST
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# WebSocket
	handle /ws/* {
		reverse_proxy localhost:8080
	}

	# Frontend Nuxt
	handle {
		reverse_proxy localhost:3000
	}
}